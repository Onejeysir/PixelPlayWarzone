# Copiez en .env (non versionné). SANS ce fichier, le site fonctionne seul (mode sans Supabase) : rien à configurer pour l'essayer.
#
# ── Interrupteur général de Supabase ──
# Tant que la valeur n'est pas exactement "true", Supabase n'est NI chargé NI initialisé, même si les clés ci-dessous sont remplies.
VITE_ENABLE_SUPABASE=false
# ── Navigateur (publiques par conception) : Supabase > Settings > API ──
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_PUBLIQUE_ANON
# ── Serveur UNIQUEMENT (fonctions Vercel). Jamais de préfixe VITE_ : sinon la clé serait publiée dans le site ! ──
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE
